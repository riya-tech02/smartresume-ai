NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/smartresume
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long_for_security
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
PRINT_TOKEN_SECRET=your_print_token_secret_min_32_characters_long_for_security
CLIENT_URL=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=15000
AI_DAILY_LIMIT=30
PDF_MAX_CONCURRENCY=2
PDF_TIMEOUT_MS=20000
PUPPETEER_EXECUTABLE_PATH=
LOG_LEVEL=info
